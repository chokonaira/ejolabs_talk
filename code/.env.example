# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# .env is already in .gitignore. Check that it stays there. A key pushed to a
# public repository is a key someone else is now using on your daily quota.

# From Ejo Labs, after admin approval. Real keys look like kgpt_xxxxxxxx.
# Fake teaching example, do not use:
# EJO_API_KEY=kgpt_demo_key_for_class_only
#
# Free tier: 50 requests/day. Approved accounts get a 48-hour trial first,
# at 10 requests/minute and 100 requests/day.
EJO_API_KEY=

# Force the offline mock even when a key is present. Useful for demos and for
# not burning 50 requests/day while you are debugging a chunker.
EJO_OFFLINE=

# Which embedding backend to use. Default is `hashing`, which downloads
# nothing. Others: random, st:paraphrase-multilingual-MiniLM-L12-v2, st:LaBSE
EJO_EMBEDDER=hashing

# Vector database demos only.
# DATABASE_URL=postgresql://postgres:pw@localhost:5432/postgres
